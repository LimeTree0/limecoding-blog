---
import type { CollectionEntry } from "astro:content";
import { formatDate, postUrl } from "../lib/posts";
interface Props { post: CollectionEntry<"posts">; compact?: boolean; }
const { post, compact = false } = Astro.props;
---
<article class:list={["post-item", { compact }]}>
    <div class="cover" aria-hidden="true">
        <img src="/images/design/article-circuit.svg" width="128" height="80" alt="" loading="lazy" />
        <span>CODE → CIRCUIT</span>
    </div>
    <div class="post-content">
        <p class="post-tags">{post.data.tags.join(" · ")}</p>
        <h3 class="post-title"><a href={postUrl(post.id)}>{post.data.title}</a></h3>
        <p class="post-description">{post.data.description}</p>
        <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
    </div>
</article>
<style>
    .post-item { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 24px; padding-bottom: 24px; }
    .cover { padding: 16px; background: var(--color-surface); }
    .cover span { display: block; margin-top: 8px; font: 13px/25px var(--font-code); white-space: nowrap; }
    .post-content { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
    .post-tags, time { font-size: 12px; line-height: 20px; }
    .post-title { font-family: var(--font-body); font-size: 20px; line-height: 32px; word-break: keep-all; }
    .post-title a { text-decoration: none; }
    .post-title a:hover { text-decoration: underline; }
    .post-description { font-size: 13px; line-height: 23px; color: var(--color-muted); }
    time { color: var(--color-muted); }
    @media (max-width: 600px) {
        .post-item { display: block; padding-bottom: 32px; border-bottom: 1px solid var(--color-line); }
        .cover { display: none; }
        .compact .post-description { display: none; }
    }
</style>
