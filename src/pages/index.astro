---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroArtwork from "../components/HeroArtwork.astro";
import PostListItem from "../components/PostListItem.astro";
import { getPublishedPosts, postUrl } from "../lib/posts";

const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
const startingPost = posts.find((post) => post.id === "why-astro");
const nextPost = posts.find((post) => post.id === "react-in-astro");
---
<BaseLayout title="Limecoding | 이해하는 즐거움, 연결하는 상상력">
    <main class="container">
        <section class="hero" aria-labelledby="hero-title">
            <div class="hero-intro">
                <p class="hero-label">LIMECODING / TECH &amp; CURIOSITY</p>
                <h1 id="hero-title">이해하는 즐거움,<br />연결하는 상상력.</h1>
                <p class="hero-description">코드가 동작하는 원리를 탐구하고,<br />기술 사이의 연결을 풀어봅니다.</p>
            </div>
            <HeroArtwork />
        </section>
        <div class="home-content">
            <section id="posts" aria-labelledby="posts-title">
                <h2 id="posts-title">최근에 들여다본 것들</h2>
                <ul class="post-list">
                    {posts.slice(0, 3).map((post) => <li><PostListItem post={post} compact /></li>)}
                </ul>
                {posts.length === 0 && <p>첫 번째 글을 준비하고 있습니다.</p>}
                {posts.length > 3 && <a class="all-posts" href="/posts/">모든 글 보기 ↗</a>}
                {startingPost && nextPost && (
                    <aside class="reading-path" aria-labelledby="reading-path-title">
                        <p class="label">READING PATH / 2 NOTES</p>
                        <h3 id="reading-path-title">Astro로 시작하는 블로그</h3>
                        <p class="path-description">블로그를 시작한 이유에서 React 컴포넌트까지.</p>
                        <a href={postUrl(startingPost.id)}>순서대로 읽어보기 ↗</a>
                    </aside>
                )}
            </section>
            <aside class="sidebar" aria-label="글 탐색">
                <section>
                    <h2>관심사를 따라</h2>
                    <div class="topics">{tags.map((tag) => <a class="pill" href={`/posts/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
                </section>
                <section class="connections">
                    <h2>뜻밖의 연결</h2>
                    <p>하나의 질문에서<br />다음 생각으로 이어집니다.</p>
                    <button class="primary-link" type="button" disabled title="연결 탐색은 준비 중입니다">연결 탐색 · 준비 중</button>
                </section>
            </aside>
        </div>
    </main>
</BaseLayout>
<style>
    .hero { display: grid; grid-template-columns: minmax(0, 612fr) minmax(0, 520fr); align-items: center; gap: 32px; padding-block: 40px; border-bottom: 1px solid var(--color-line); }
    .hero-intro { display: flex; flex-direction: column; gap: 24px; }
    .hero-label { font-size: 12px; line-height: 20px; color: var(--color-muted); }
    h1 { font-size: clamp(32px, 3.34vw, 48px); line-height: 70px; }
    .hero-description { font-size: 15px; line-height: 27px; }
    .home-content { display: grid; grid-template-columns: minmax(0, 850px) minmax(0, 260px); gap: 48px; padding-top: 40px; }
    #posts-title { margin-bottom: 24px; font-size: 28px; line-height: 42px; }
    .post-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; }
    .sidebar h2 { font: 700 20px/32px var(--font-body); margin-bottom: 24px; }
    .topics { display: flex; flex-wrap: wrap; gap: 8px; }
    .connections { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--color-line); }
    .connections p { margin-bottom: 24px; font-size: 13px; line-height: 23px; }
    .connections button { cursor: not-allowed; }
    .reading-path { display: grid; gap: 12px; margin-top: 24px; padding: 24px; background: var(--color-surface); }
    .label, .reading-path a, .all-posts { font-size: 12px; line-height: 20px; }
    .reading-path a { text-decoration: none; }
    .reading-path a:hover { text-decoration: underline; }
    .path-description { font-size: 13px; line-height: 23px; }
    .all-posts { display: inline-block; margin-top: 24px; }
    @media (max-width: 1000px) {
        .home-content { grid-template-columns: minmax(0, 1fr); }
        .sidebar { display: none; }
        h1 { line-height: 1.5; }
    }
    @media (max-width: 600px) {
        .hero { grid-template-columns: minmax(0, 1fr); gap: 32px; padding-block: 32px; }
        .hero-label { display: none; }
        .hero-intro { gap: 32px; }
        h1 { font-size: 28px; line-height: 42px; }
        .hero-description { font-size: 13px; line-height: 23px; }
        .home-content { padding-top: 32px; }
        #posts-title { margin-bottom: 32px; font: 700 20px/32px var(--font-body); }
        .post-list { gap: 32px; }
        .reading-path { display: none; }
    }
</style>
